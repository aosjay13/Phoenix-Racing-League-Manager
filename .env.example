# ── Server (Firebase Admin — from your service account JSON) ──
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Storage bucket for logo/avatar uploads (Firebase console → Storage). Usually <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Comma-separated emails that get league-admin access
ADMIN_EMAILS=you@example.com

# Anthropic API key — powers the Smart Importer's Gran Turismo 7 screenshot OCR
# (Claude vision). Optional: without it, CSV/paste import still works; screenshot
# import returns a "not configured" message. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret that lets the weekly backup job (.github/workflows/weekly-backup.yml)
# call GET /api/admin/backup without a Firebase account. Set it to the same long random
# string here and in the repo's BACKUP_CRON_SECRET Actions secret. Leave it unset and
# token access is off — only a signed-in Owner can export. It can never restore a
# backup; importing is always Owner-only. See "Backups & disaster recovery" in README.md
BACKUP_CRON_SECRET=

# ── Client (Firebase Web App config — Firebase console → Project settings → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
