# ── Server (Firebase Admin — from your service account JSON) ──
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Storage bucket for logo/avatar uploads (Firebase console → Storage). Usually <project-id>.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Comma-separated emails that get league-admin access
ADMIN_EMAILS=you@example.com

# Anthropic API key — powers the Smart Importer's Gran Turismo 7 screenshot OCR
# (Claude vision). Optional: without it, CSV/paste import still works; screenshot
# import returns a "not configured" message. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret that lets the weekly backup job (.github/workflows/weekly-backup.yml)
# call GET /api/admin/backup without a Firebase account. Set it to the same long random
# string here and in the repo's BACKUP_CRON_SECRET Actions secret. Leave it unset and
# token access is off — only a signed-in Owner can export. It can never restore a
# backup; importing is always Owner-only. See "Backups & disaster recovery" in README.md
BACKUP_CRON_SECRET=

# ── Emergency access ──────────────────────────────────────────────────────────
# The way back in when EMAIL ITSELF is broken. Every other door needs a working
# inbox: signing up needs a verification link, a forgotten password needs a reset
# link, and being let in by an Owner needs an Owner who is already in.
#
# Set this to a long random string (32+ chars: `openssl rand -hex 32`) and visit
# /recover. Entering an account's email plus this code marks that account
# verified and makes it an Owner — no email involved. Leave it UNSET and the
# route refuses everything, which is the right state in normal operation.
#
# REMOVE IT AGAIN once you are back in. A recovery code left in place is a
# permanent way for anyone who can read your environment to make themselves an
# Owner. Codes shorter than 16 characters are refused rather than trusted.
OWNER_RECOVERY_CODE=

# Whether new accounts must confirm their email address before they can use the
# app. Defaults to true (leave unset). Setting it to "false" stands an
# installation up with the verification wall down — useful while email delivery
# is being sorted out. An Owner can also flip this from Admin ▸ User Accounts
# WITHOUT a redeploy, and that stored setting overrides this one either way.
REQUIRE_EMAIL_VERIFICATION=

# ── Client (Firebase Web App config — Firebase console → Project settings → Your apps) ──
# These are inlined into the browser bundle at BUILD time. A deploy built without
# them ships an app that cannot reach Firebase at all — sign-in, sign-up and
# every email fail — so setting them later needs a REBUILD, not a restart. The
# sign-in screen names any that are missing.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
